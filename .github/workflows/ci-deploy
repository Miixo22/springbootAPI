name: CI Build & Deploy (self-hosted runner)

on:
  push:
    branches: [ main ]

jobs:
  build:
    name: Build JAR
    runs-on: ubuntu-latest
    outputs:
      artifact-name: app-jar
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Java 21
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'

      - name: Build with Maven
        run: mvn -B package -DskipTests

      - name: Upload JAR artifact
        uses: actions/upload-artifact@v4
        with:
          name: app-jar
          path: target/*.jar

  deploy:
    name: Deploy on self-hosted runner (no SSH)
    needs: build
    runs-on: [self-hosted, linux, api_server]
    steps:
      - name: Download built JAR
        uses: actions/download-artifact@v4
        with:
          name: app-jar
          path: .

      - name: Ensure Java is installed on runner
        run: |
          sudo apt-get update
          sudo apt-get install -y openjdk-21-jre-headless

      - name: Prepare application dir and copy JAR
        run: |
          sudo mkdir -p /opt/springboot-api
          sudo cp *.jar /opt/springboot-api/application.jar
          sudo chmod 755 /opt/springboot-api/application.jar

      - name: Install systemd service and start app
        run: |
          sudo tee /etc/systemd/system/springboot-app.service > /dev/null <<'EOF'
          [Unit]
          Description=Spring Boot Application
          After=network.target

          [Service]
          User=root
          ExecStart=/usr/bin/java -jar /opt/springboot-api/application.jar
          Restart=always
          RestartSec=10
          StandardOutput=journal
          StandardError=journal

          [Install]
          WantedBy=multi-user.target
          EOF
          sudo systemctl daemon-reload
          sudo systemctl enable --now springboot-app.service

      - name: Health check
        run: |
          for i in {1..10}; do
            if curl -sS http://localhost:8080/actuator/health >/dev/null; then
              echo "app healthy"
              exit 0
            fi
            sleep 5
          done
          echo "health check failed" >&2
          exit 1
